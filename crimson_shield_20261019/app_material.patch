+    /// Follows the shield texture's straight diagonal U direction. Its back
+    /// is a half turn of the front, so only the X direction reverses there.
+    static func withShieldFieldTangents(
+        _ contents: MeshResource.Contents,
+        onPartsUsing materialIndices: Set<Int>
+    ) -> MeshResource.Contents {
+        editingEveryPart(of: contents) { part in
+            guard materialIndices.contains(part.materialIndex), let normals = part.normals else { return part }
+            var tangents: [SIMD3<Float>] = []
+            var bitangents: [SIMD3<Float>] = []
+            for (position, normal) in zip(part.positions, normals) {
+                let brushDirection = SIMD3<Float>(position.z < 0 ? -0.840 : 0.840, 0.543, 0)
+                let tangent = projectedShieldBrushDirection(brushDirection, normal: normal)
+                tangents.append(tangent)
+                bitangents.append(simd_cross(normal, tangent))
+            }
+            var part = part
+            part.tangents = MeshBuffers.Tangents(tangents)
+            part.bitangents = MeshBuffers.Tangents(bitangents)
+            return part
+        }
+    }
+
+    private static func projectedShieldBrushDirection(
+        _ direction: SIMD3<Float>, normal: SIMD3<Float>
+    ) -> SIMD3<Float> {
+        let surfaceNormal = simd_normalize(normal)
+        let inSurface = direction - simd_dot(direction, surfaceNormal) * surfaceNormal
+        if simd_length(inSurface) > 1e-6 { return simd_normalize(inSurface) }
+        // A face parallel to the brush direction needs another tangent axis.
+        let fallbackAxis = abs(surfaceNormal.z) < 0.9 ? SIMD3<Float>(0, 0, 1) : SIMD3<Float>(1, 0, 0)
+        return simd_normalize(simd_cross(surfaceNormal, fallbackAxis))
+    }
