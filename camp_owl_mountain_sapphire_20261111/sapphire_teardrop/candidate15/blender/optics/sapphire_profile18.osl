/* Same three hit physical optics as the existing private preview sapphire profile.
   This is calculated per camera ray; no appearance image or reference is sampled. */
float fshare(float c, float ni, float nt) {
 float ci=clamp(c,0,1);float s=(ni/nt)*(ni/nt)*(1-ci*ci);if(s>=1)return 1;
 float ct=sqrt(1-s);float a=(ni*ci-nt*ct)/(ni*ci+nt*ct);float b=(ni*ct-nt*ci)/(ni*ct+nt*ci);return .5*(a*a+b*b);
}
color studio(vector d, string sharpfile, string tentfile, int withtent) {
 vector w=normalize(transform("object","world",d));
 /* Blender world X,Y,Z becomes app X,Z,-Y, then the existing half turn. */
 vector e=vector(-w[0],w[2],w[1]);
 float u=.5+atan2(e[0],-e[2])/(2*M_PI);float v=1-(.5-asin(clamp(e[1],-1,1))/M_PI);
 color a=texture(sharpfile,u,v,"swrap","periodic","twrap","clamp","interp","bilinear");a=clamp(a,color(0),color(24));
 if(withtent){color b=texture(tentfile,u,v,"swrap","periodic","twrap","clamp","interp","bilinear");a+=clamp(b,color(0),color(3))*1.4576831;}
 return a;
}
int findexit(point p, vector d, vector planes[], float offsets[], output float distance, output vector norm) {
 int found=0;distance=1e30;norm=vector(0);
 for(int k=0;k<arraylength(planes);k++) {
  float approach=dot(planes[k],d);if(approach<=.0001)continue;
  float gap=offsets[k]-dot(planes[k],vector(p));if(gap<=-.00001)continue;
  float t=max(gap,0)/approach;if(t<distance){found=1;distance=t;norm=planes[k];}
 }
 return found;
}
