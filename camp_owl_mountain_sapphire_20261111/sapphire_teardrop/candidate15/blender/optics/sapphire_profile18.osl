 vector inc=-normalize(transform("world","object",I));
 normal on=normalize(transform("world","object",N));vector n=vector(on);
 if(dot(n,inc)>0)n=-n;
 float f=fshare(dot(n,-inc),1,1.77);
 color result=f*studio(reflect(inc,n),SharpMap,TentMap,0);
 color weight=color(1-f);vector dir=refract(inc,n,1/1.77);
 color extinction=color(8,4.3503597,.2)*Density;
 for(int hit=0;hit<3;hit++) {
  float distance;vector fn;
  if(!findexit(pos,dir,planes,offsets,distance,fn))break;
  pos+=dir*distance;
  weight*=color(exp(-extinction[0]*distance),exp(-extinction[1]*distance),exp(-extinction[2]*distance));
  float share=fshare(dot(fn,dir),1.77,1);
  if(share<1) {
   vector green=refract(dir,-fn,1.77);vector red=refract(dir,-fn,1.76);vector blue=refract(dir,-fn,1.79);
   if(dot(red,red)<1e-15)red=green;if(dot(blue,blue)<1e-15)blue=green;
   color r=studio(red,SharpMap,TentMap,1);color g=studio(green,SharpMap,TentMap,1);color b=studio(blue,SharpMap,TentMap,1);
   result+=weight*(1-share)*color(r[0],g[1],b[2]);
  }
  weight*=share;dir=reflect(dir,fn);
 }
 result+=weight*studio(dir,SharpMap,TentMap,1);
