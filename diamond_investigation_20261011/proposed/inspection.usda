#usda 1.0
(
    defaultPrim = "DiamondCrystal"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "DiamondCrystal"
{
    def "Materials"
    {
        def Material "DiamondCrystal_Front"
        {
            token outputs:surface.connect = </DiamondCrystal/Materials/DiamondCrystal_Front/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.2, 0.5)
                color3f inputs:diffuseColor.connect = </DiamondCrystal/Materials/DiamondCrystal_Front/diffuseColor.outputs:rgb>
                color3f inputs:emissiveColor.connect = </DiamondCrystal/Materials/DiamondCrystal_Front/emissiveColor.outputs:rgb>
                float inputs:metallic = 1
                float inputs:roughness = 0.32
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "BadgeUV"
                float2 outputs:result
            }

            def Shader "diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @0/color.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DiamondCrystal/Materials/DiamondCrystal_Front/UV.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "emissiveColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @0/emissive.png@
                float4 inputs:scale = (4, 4, 4, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DiamondCrystal/Materials/DiamondCrystal_Front/UV.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "DiamondCrystal_Back"
        {
            token outputs:surface.connect = </DiamondCrystal/Materials/DiamondCrystal_Back/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.075, 0.23)
                float inputs:metallic = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "DiamondCrystal_Edges"
        {
            token outputs:surface.connect = </DiamondCrystal/Materials/DiamondCrystal_Edges/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.24, 0.53)
                float inputs:metallic = 1
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }
    }

